    "allowed_ip_rules": {
     "default": [],
     "description": "Source IPs permitted through the storage firewall."
    },
    "cost_center": {
     "default": "CC-1042",
     "description": "Cost centre for budget attribution (CAF-COST-001)."
    },
    "environment": {
     "default": "dev",
     "description": "Environment tier. Drives both the naming standard and the cost rules."
    },
    "location": {
     "default": "centralindia",
     "description": "Azure region. Must be in the approved landing-zone list (CAF-LZ-001)."
    },
    "log_daily_quota_gb": {
     "default": 0.1,
     "description": "Hard daily ingestion cap on Log Analytics. 0.1 GB keeps the workspace\ninside the free tier permanently; ingestion simply stops rather than\nbilling once the cap is hit.\n"
    },
    "owner": {
     "default": "platform-team@example.com",
     "description": "Owning team email (CAF-GOV-001)."
    },
    "public_network_access": {
     "default": false,
     "description": "Whether the storage account is reachable from the public internet.\n\nDefaults to false, which is both free and compliant: disabling public\nnetwork access costs nothing, and it is what lets this module pass its\nown gate cleanly. A real landing zone would then add a private endpoint\nfor access -- we skip that because private endpoints cost roughly\nRs 600/month each, far more than the rest of this module combined, and\nnothing in the demo needs to read the blob.\n\nFlip this to true if you want to browse the container in the portal: the\ngate will immediately flag it as CAF-LZ-002 (HIGH) and block the deploy,\nwhich is a useful thing to demonstrate live.\n"
    },
    "region_short": {
     "default": "cin",
     "description": "Short region code for resource names."
    },
    "replication_type": {
     "default": "LRS",
     "description": "Storage replication. LRS is the cheapest and is fine below production;\nthe gate (WAF-REL-001) only demands ZRS/GRS for prod-tagged accounts,\nso the default here keeps demo spend at its floor.\n"
    },
    "use_oidc": {
     "default": false,
     "description": "Authenticate via GitHub OIDC federation (true in CI, false locally)."
    },
    "workload": {
     "default": "secops",
     "description": "Workload name used as the naming prefix (CAF-GOV-002)."
    }
   }
  }
